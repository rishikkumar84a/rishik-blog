<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= post.title %> | RKC Insights</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/favicon.ico">
  <meta name="description" content="<%= post.content.substring(0, 160) %>">
</head>
<body>
  <header>
    <div class="container">
      <div class="logo">
        <a href="/"><img src="/blog_logo.png" alt="RKC Insights Logo" class="logo-img"> RKC Insights</a>
      </div>
      <nav>
        <ul>
          <li><a href="/">Home</a></li>
          <li class="dropdown">
            <a href="#">Categories</a>
            <div class="dropdown-content">
              <% categories.forEach(category => { %>
                <a href="/category/<%= category.name %>"><%= category.name %></a>
              <% }); %>
            </div>
          </li>
          <li><a href="/contact">Contact</a></li>
          <li><a href="https://rishikkumarchaurasiya.live/" target="_blank">Portfolio</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main>
    <article class="blog-post">
      <div class="container">
        <div class="post-header">
          <h1><%= post.title %></h1>
          <div class="post-meta">
            <span class="category"><a href="/category/<%= post.category %>"><%= post.category %></a></span>
            <span class="date">Published on <%= new Date(post.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
          </div>
        </div>
        
        <% if (post.imageUrl) { %>
          <div class="post-featured-image">
            <img src="<%= post.imageUrl %>" alt="<%= post.title %>">
          </div>
        <% } %>
        
        <% if (post.videoUrl) { %>
          <div class="post-video">
            <iframe width="100%" height="500" src="<%= post.videoUrl %>" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
          </div>
        <% } %>
        
        <div class="post-content">
          <%- post.content %>
        </div>
        
        <div class="post-footer">
          <div class="share-buttons">
            <h3>Share this post</h3>
            <a href="https://twitter.com/intent/tweet?url=<%= encodeURIComponent(`${req.protocol}://${req.get('host')}${req.originalUrl}`) %>&text=<%= encodeURIComponent(post.title) %>" target="_blank" class="share-button twitter">Twitter</a>
            <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(`${req.protocol}://${req.get('host')}${req.originalUrl}`) %>" target="_blank" class="share-button facebook">Facebook</a>
            <a href="https://www.linkedin.com/shareArticle?mini=true&url=<%= encodeURIComponent(`${req.protocol}://${req.get('host')}${req.originalUrl}`) %>&title=<%= encodeURIComponent(post.title) %>" target="_blank" class="share-button linkedin">LinkedIn</a>
          </div>
        </div>
      </div>
    </article>
  </main>

  <footer>
    <div class="container">
      <div class="footer-content">
        <div class="footer-logo">
          <h3>Rishik's Blog</h3>
          <p>Connecting thoughts with the world</p>
        </div>
        <div class="footer-links">
          <h4>Quick Links</h4>
          <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/contact">Contact</a></li>
            <li><a href="https://rishikkumarchaurasiya.live/" target="_blank">Portfolio</a></li>
          </ul>
        </div>
        <div class="footer-social">
          <h4>Connect With Me</h4>
          <div class="social-icons">
            <a href="https://linkedin.com/in/your-linkedin" target="_blank" class="social-icon">LinkedIn</a>
            <a href="https://github.com/your-github" target="_blank" class="social-icon">GitHub</a>
            <a href="https://wa.me/your-whatsapp-number" target="_blank" class="social-icon">WhatsApp</a>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; <%= new Date().getFullYear() %> Rishik Kumar Chaurasiya. All rights reserved.</p>
      </div>
    </div>
  </footer>

  <script src="/js/main.js"></script>
</body>
</html>