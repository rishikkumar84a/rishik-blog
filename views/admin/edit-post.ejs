<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Post | Admin Dashboard</title>
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="icon" href="/favicon.ico">
</head>
<body class="admin-dashboard">
  <header class="admin-header">
    <div class="container">
      <div class="admin-logo">
        <img src="/blog_logo.png" alt="RKC Insights Logo" class="admin-logo-img">
        <h1>Admin Dashboard</h1>
      </div>
      <nav class="admin-nav">
        <ul>
          <li><a href="/admin/dashboard">Dashboard</a></li>
          <li><a href="/admin/categories">Categories</a></li>
          <li><a href="/" target="_blank">View Blog</a></li>
          <li><a href="/admin/logout">Logout</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main class="admin-main">
    <div class="container">
      <div class="dashboard-header">
        <h2>Edit Post</h2>
        <a href="/admin/dashboard" class="btn-cancel">Back to Dashboard</a>
      </div>

      <div class="post-form">
        <form action="/admin/posts/edit/<%= post._id %>" method="POST" enctype="multipart/form-data">
          <div class="form-row">
            <div class="form-group">
              <label for="title">Post Title</label>
              <input type="text" id="title" name="title" class="form-control" value="<%= post.title %>" required>
            </div>
            <div class="form-group">
              <label for="category">Category</label>
              <select id="category" name="category" class="form-control" required>
                <% categories.forEach(category => { %>
                  <option value="<%= category.name %>" <%= post.category === category.name ? 'selected' : '' %>><%= category.name %></option>
                <% }); %>
              </select>
            </div>
          </div>
          
          <div class="form-group full-width">
            <label for="content">Content</label>
            <textarea id="content" name="content" class="form-control" required><%= post.content %></textarea>
          </div>
          
          <div class="form-row">
            <div class="form-group">
              <label for="image">Featured Image</label>
              <% if (post.imageUrl) { %>
                <div class="current-image">
                  <p>Current image: <a href="<%= post.imageUrl %>" target="_blank">View</a></p>
                </div>
              <% } %>
              <input type="file" id="image" name="image" class="form-control">
              <small>Leave empty to keep current image</small>
            </div>
            <div class="form-group">
              <label for="videoUrl">Video URL (optional)</label>
              <input type="text" id="videoUrl" name="videoUrl" class="form-control" value="<%= post.videoUrl || '' %>" placeholder="e.g., https://www.youtube.com/embed/video-id">
            </div>
          </div>
          
          <div class="form-actions">
            <a href="/admin/dashboard" class="btn-cancel">Cancel</a>
            <button type="submit" class="btn-save">Update Post</button>
          </div>
        </form>
      </div>
    </div>
  </main>

  <footer class="admin-footer">
    <div class="container">
      <p>&copy; <%= new Date().getFullYear() %> Rishik's Blog Admin Panel</p>
    </div>
  </footer>

  <script>
    // Add a basic WYSIWYG editor for the content textarea
    document.addEventListener('DOMContentLoaded', function() {
      const contentArea = document.getElementById('content');
      
      // Add a simple preview functionality
      contentArea.addEventListener('input', function() {
        // You could add more sophisticated preview functionality here
        console.log('Content updated');
      });
    });
  </script>
</body>
</html>