<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard | RKC Insights</title>
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="icon" href="/favicon.ico">
</head>
<body class="admin-dashboard">
  <header class="admin-header">
    <div class="container">
      <div class="admin-logo">
        <img src="/blog_logo.png" alt="RKC Insights Logo" class="admin-logo-img">
        <h1>Admin Dashboard</h1>
      </div>
      <nav class="admin-nav">
        <ul>
          <li><a href="/admin/dashboard" class="active">Dashboard</a></li>
          <li><a href="/admin/categories">Categories</a></li>
          <li><a href="/" target="_blank">View Blog</a></li>
          <li><a href="/admin/logout">Logout</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main class="admin-main">
    <div class="container">
      <div class="dashboard-header">
        <h2>Manage Blog Posts</h2>
        <a href="/admin/posts/new" class="btn-new">Create New Post</a>
      </div>

      <div class="posts-table-container">
        <% if (posts.length > 0) { %>
          <table class="posts-table">
            <thead>
              <tr>
                <th>Title</th>
                <th>Category</th>
                <th>Created</th>
                <th>Updated</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% posts.forEach(post => { %>
                <tr>
                  <td><%= post.title %></td>
                  <td><%= post.category %></td>
                  <td><%= new Date(post.createdAt).toLocaleDateString() %></td>
                  <td><%= new Date(post.updatedAt).toLocaleDateString() %></td>
                  <td class="actions">
                    <a href="/post/<%= post._id %>" class="btn-view" target="_blank">View</a>
                    <a href="/admin/posts/edit/<%= post._id %>" class="btn-edit">Edit</a>
                    <form action="/admin/posts/delete/<%= post._id %>" method="POST" class="delete-form">
                      <button type="submit" class="btn-delete" onclick="return confirm('Are you sure you want to delete this post?')">Delete</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        <% } else { %>
          <div class="no-posts">
            <p>No posts available. Create your first post!</p>
            <a href="/admin/posts/new" class="btn-new">Create New Post</a>
          </div>
        <% } %>
      </div>
    </div>
  </main>

  <footer class="admin-footer">
    <div class="container">
      <p>&copy; <%= new Date().getFullYear() %> Rishik's Blog Admin Panel</p>
    </div>
  </footer>

  <script>
    // Confirm delete action
    document.addEventListener('DOMContentLoaded', function() {
      const deleteForms = document.querySelectorAll('.delete-form');
      deleteForms.forEach(form => {
        form.addEventListener('submit', function(e) {
          const confirmed = confirm('Are you sure you want to delete this post?');
          if (!confirmed) {
            e.preventDefault();
          }
        });
      });
    });
  </script>
</body>
</html>