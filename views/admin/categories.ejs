<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage Categories | Admin Dashboard</title>
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="icon" href="/favicon.ico">
</head>
<body class="admin-dashboard">
  <header class="admin-header">
    <div class="container">
      <div class="admin-logo">
        <img src="/blog_logo.png" alt="RKC Insights Logo" class="admin-logo-img">
        <h1>Admin Dashboard</h1>
      </div>
      <nav class="admin-nav">
        <ul>
          <li><a href="/admin/dashboard">Dashboard</a></li>
          <li><a href="/admin/categories" class="active">Categories</a></li>
          <li><a href="/" target="_blank">View Blog</a></li>
          <li><a href="/admin/logout">Logout</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main class="admin-main">
    <div class="container">
      <div class="dashboard-header">
        <h2>Manage Categories</h2>
        <a href="/admin/dashboard" class="btn-cancel">Back to Dashboard</a>
      </div>

      <div class="categories-container">
        <div class="category-form">
          <h3>Add New Category</h3>
          <form action="/admin/categories/new" method="POST">
            <div class="form-group">
              <label for="name">Category Name</label>
              <input type="text" id="name" name="name" class="form-control" required>
            </div>
            <button type="submit" class="btn-save">Add Category</button>
          </form>
        </div>
        
        <div class="categories-list">
          <h3>Existing Categories</h3>
          <% if (categories.length > 0) { %>
            <% categories.forEach(category => { %>
              <div class="category-item">
                <span><%= category.name %></span>
                <form action="/admin/categories/delete/<%= category._id %>" method="POST" class="delete-form">
                  <button type="submit" class="btn-delete" onclick="return confirm('Are you sure you want to delete this category? This may affect posts using this category.')">Delete</button>
                </form>
              </div>
            <% }); %>
          <% } else { %>
            <p>No categories available. Add your first category!</p>
          <% } %>
        </div>
      </div>
    </div>
  </main>

  <footer class="admin-footer">
    <div class="container">
      <p>&copy; <%= new Date().getFullYear() %> Rishik's Blog Admin Panel</p>
    </div>
  </footer>

  <script>
    // Confirm delete action
    document.addEventListener('DOMContentLoaded', function() {
      const deleteForms = document.querySelectorAll('.delete-form');
      deleteForms.forEach(form => {
        form.addEventListener('submit', function(e) {
          const confirmed = confirm('Are you sure you want to delete this category? This may affect posts using this category.');
          if (!confirmed) {
            e.preventDefault();
          }
        });
      });
    });
  </script>
</body>
</html>